<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.htn.breadboardar.ar.ArCameraPreview
            android:id="@+id/ar_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.htn.breadboardar.ui.CalibrationOverlayView
            android:id="@+id/calibration_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:background="@color/viewer_overlay"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/viewer_text"
            android:textSize="14sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/viewer_overlay"
        android:orientation="vertical"
        android:padding="12dp">

        <EditText
            android:id="@+id/server_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Laptop WebSocket URL (ws://192.168.x.x:8080/ar)"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/viewer_text"
            android:textColorHint="#B3FFFFFF" />

        <EditText
            android:id="@+id/session_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Session ID"
            android:inputType="text"
            android:maxLines="1"
            android:text="demo-button-led"
            android:textColor="@color/viewer_text"
            android:textColorHint="#B3FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/connect_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Connect" />

            <Button
                android:id="@+id/calibrate_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="Calibrate" />

            <Button
                android:id="@+id/reset_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="Reset" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

